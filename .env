# ─────────────────────────────────────────────
#  Focus Track – .env
#  Variáveis de ambiente do projeto
#  ⚠️  NÃO commitar este arquivo no Git!
# ─────────────────────────────────────────────

# ── Aplicação ─────────────────────────────────
APP_NAME="Focus Track"
APP_VERSION="1.0.0"
APP_DESCRIPTION="API REST profissional para gerenciamento de tarefas e produtividade."
DEBUG=true
ENVIRONMENT=development

# ── Servidor ──────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Banco de Dados ────────────────────────────
# SQLite (padrão para desenvolvimento)
DATABASE_URL=sqlite:///./focus_track.db

# PostgreSQL (descomente para produção)
# DATABASE_URL=postgresql://user:password@localhost:5432/focus_track_db

# ── Segurança / JWT (preparado para autenticação futura) ──
SECRET_KEY=sua-chave-secreta-super-segura-troque-em-producao-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (separar por vírgula para múltiplas origens) ─────
# Permite o frontend React em desenvolvimento
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ── Paginação ─────────────────────────────────
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
